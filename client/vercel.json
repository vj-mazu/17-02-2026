{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mother-india-server.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api|static|favicon.ico|manifest.json|robots.txt|logo192.png|logo512.png).*)",
      "destination": "/index.html"
    }
  ]
}
